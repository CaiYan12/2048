      "foreground": "#5f564e",
      "background": "#faf8ef",
      "minimum": 4.5,
      "ratio": 6.74,
      "scene": "run",
      "probe": { "selector": ".hint", "background": ".shell" }
    },
    {
      "usage": "开局界面的分组小标签（模式 / 风格那两行）。.panel__label 用 opacity .85 把正文色压在纸面上，合成后才是真正看到的颜色——T14 交接条目 2",
      "basis": "regular",
      "foreground": "#766e66",
